# ---- Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Data/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.unityproj
*.tmp
.vs/
.vscode/
.idea/
crashlytics-buildid.txt
sysinfo.txt
*.apk
*.aab
*.unitypackage

# ---- builds (the playable web build lives on itch.io; rebuild with Kampung Run > Build WebGL)
/Builds/*
!/Builds/promo/
!/Builds/ITCH_PAGE.md

# ---- Blender working files and duplicate exports (regenerated by Tools/blender/kl/kl_build.py;
#      the FBX the game uses are committed under Assets/Models)
*.blend
*.blend1
*.fbm/
/Tools/kl_assets/**/*.fbx
/Tools/kl_assets/**/textures/

# ---- test screenshots (regenerated by the PlayMode tests); a curated set lives in docs/
/Tools/previews/

# ---- third-party tooling / local editor config
/Tools/blender-mcp/
/.claude/
__pycache__/
*.pyc

# ---- promo video frames (Tests/PromoCapture.cs) and renders (Tools/make_promo.py)
/Tools/promo_frames/
/Tools/promo_out/
/Tools/_*.jpg

# ---- real-KL map pipeline (Tools/klmap): the generated patches in Resources/KLMap are committed; the inputs
#      are fetched again by fetch_osm.py / fetch_extra.py, and the satellite reference (Esri World Imagery,
#      used only to eyeball the layout) must never be redistributed
/Tools/klmap/tiles/
/Tools/klmap/*.jpg
/Tools/klmap/*.png
/Tools/klmap/kl_osm*.json
/Tools/klmap/out/
/Tools/klmap/fix_p*.py
/Tools/klmap/probe.py
/Tools/klmap/probe[0-9].py
